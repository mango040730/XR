# Copy to .env.social. Do not commit real TURN credentials.
HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3001,http://localhost:3001
STATIC_DIRECTORY=dist
# Supply your own operating STUN/TURN endpoints for Internet voice.
# RTC_ICE_SERVERS='[{"urls":"stun:stun.example.com:3478"},{"urls":"turns:turn.example.com:5349?transport=tcp","username":"temporary-user","credential":"temporary-secret"}]'
RTC_ICE_SERVERS=[]
